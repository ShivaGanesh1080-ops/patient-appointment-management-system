# ==============================================================================
# MediPulse - Environment Configuration Template
# Copy this file to .env for local customized overrides
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
BOOKING_RATE_LIMIT_MAX=30

# Anti-Bot & Helmet Configuration
HELMET_ENABLED=true
CORS_ORIGIN=*
